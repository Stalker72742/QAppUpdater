// Resources of one exe, generated by qau_setup().

// RT_MANIFEST (24), id 1: the process manifest (private assembly with the DLLs).
1 24 "app.manifest"

@QAU_ICON_LINE@

// The version the updater reads back as "installed" and Explorer shows under Properties > Details.
1 VERSIONINFO
FILEVERSION     @QAU_VERSION_COMMAS@
PRODUCTVERSION  @QAU_VERSION_COMMAS@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@QAU_COMPANY@"
            VALUE "FileDescription",  "@QAU_EXE_DESCRIPTION@"
            VALUE "FileVersion",      "@QAU_VERSION@"
            VALUE "InternalName",     "@QAU_EXE_NAME@"
            VALUE "OriginalFilename", "@QAU_EXE_NAME@.exe"
            VALUE "ProductName",      "@QAU_NAME@"
            VALUE "ProductVersion",   "@QAU_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
